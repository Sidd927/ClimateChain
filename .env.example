# OnceOnly configuration. Copy to .env (gitignored) and adjust.

# --- Chain -------------------------------------------------------------------
CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_DEPLOYMENT=contracts/deployments/localhost.json
# These are the PUBLICLY KNOWN Hardhat development accounts #0, #0 and #2.
# They only work on the local dev chain (chainId 31337). NEVER put a real or
# funded key here; use a fresh, test-only key for any public testnet.
REGISTRAR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
REVIEWER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
CHALLENGER_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a

# Optional public testnet deployment (contracts/hardhat.config.js `testnet` network)
# RPC_URL=https://sepolia.example-rpc
# DEPLOYER_PRIVATE_KEY=0x<test-only-key>

# --- AI extraction (optional) ------------------------------------------------
# Leave empty to run with the deterministic parser only.
ANTHROPIC_API_KEY=
ONCEONLY_LLM_MODEL=claude-opus-5-5
ONCEONLY_LLM=auto

# --- Data ----------------------------------------------------------------------
# auto: use data/reference/registry_full.sqlite if built (make data), else the committed demo subset
ONCEONLY_REFERENCE_MODE=auto
ONCEONLY_DB=var/onceonly.sqlite
